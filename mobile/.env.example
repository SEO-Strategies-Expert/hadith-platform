# عنوان الخادم — الموضع الوحيد لضبطه. انسخ هذا الملفّ إلى `.env`.
#
# للتطوير على المحاكي أو الويب مع خادم محلّي:
EXPO_PUBLIC_API_URL=http://localhost:3000
#
# على جهاز حقيقي في الشبكة نفسها، ضع عنوان الحاسوب لا localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
#
# للإنتاج:
# EXPO_PUBLIC_API_URL=https://hadith-platform-hassan67844-4138s-projects.vercel.app

# موقع الكلّية العلني — لروابط طلب الالتحاق والتحقّق من الوثائق.
EXPO_PUBLIC_WEBSITE_URL=https://hadith-platform-hassan67844-4138s-projects.vercel.app

# معرّف مشروع EAS — يلزم لإشعارات Push. يُملأ بعد `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=99e90574-5977-4972-a5f4-6a0f7aa2696c
