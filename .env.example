# MySQL database created in Hostinger hPanel (use its exact hostname and credentials).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Generate a unique secret, for example: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public canonical origin, no trailing slash.
SITE_URL="https://your-domain.example"

# Optional integrations; set only when configured.
# RESEND_API_KEY=""
# MAIL_FROM=""
# BLOB_READ_WRITE_TOKEN=""
