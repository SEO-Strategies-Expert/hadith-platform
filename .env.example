# PostgreSQL running on the same Hostinger VPS as the Node.js application.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME?schema=public"

# Generate a unique secret, for example: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public canonical origin, no trailing slash.
SITE_URL="https://your-domain.example"

# Optional integrations; set only when configured.
# RESEND_API_KEY=""
# MAIL_FROM=""
# BLOB_READ_WRITE_TOKEN=""
