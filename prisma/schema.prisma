// ==========================================================================
// Prisma schema — الكلّية العليا للحديث النبوي — منصّة ولوحة التحكم
// قاعدة البيانات: Vercel Postgres. كل المحتوى ثنائي اللغة (…Ar / …En).
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // أسماء متغيّرات Vercel Postgres — تُضاف تلقائيًا عند ربط التخزين بالمشروع
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ---------------------- المستخدمون والأدوار ----------------------
enum Role {
  ADMIN
  EDITOR
  STUDENT // حساب طالب — بوابة الطلاب فقط، لا وصول للوحة
  INSTRUCTOR // عضو هيئة تدريس — لوحته وحدها: مقرّراته ومجالسه وتصحيح طلابه
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  // --- نظام التعلّم ---
  enrollments      Enrollment[]
  stageEnrollments StageEnrollment[]
  lessonProgress   LessonProgress[]
  attendance       Attendance[]
  assignmentWork   AssignmentSubmission[] @relation("StudentWork")
  gradedWork       AssignmentSubmission[] @relation("GradedBy")
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]          @relation("CertificateHolder")
  issuedCerts      Certificate[]          @relation("CertificateIssuer")
  payments         Payment[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  devices          DeviceToken[]

  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  // ملفّ عضو الهيئة (يُستخدم عند role = INSTRUCTOR) — يربط الحساب بسيرته
  // المعروضة في الموقع، فتُشتقّ مقرّراته ومجالسه منه بلا تكرار بيانات.
  /// بلا قيد تفرّد في القاعدة (إضافته تتطلّب علمًا مسبقًا بغياب التكرار)؛
  /// «حساب واحد لكل عضو هيئة» تُفرَض في كود اللوحة بالبحث قبل الإسناد.
  scholarId    String?
  scholar      Scholar?   @relation(fields: [scholarId], references: [id], onDelete: SetNull)
  // بيانات الطالب (تُستخدم عند role = STUDENT)
  studentNo    String?
  phone        String?
  country      String?
  program      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

// ---------------------- الإعدادات العامة (key/value) ----------------------
// أمثلة المفاتيح: site.nameAr, site.nameEn, contact.email, contact.phone,
// contact.address, social.youtube, social.x, social.instagram, ...
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  group     String   @default("general") // general | contact | social | brand
  labelAr   String?
  value     Json // نص، أو {ar, en}، أو رابط
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------- التنقّل والقوائم ----------------------
enum MenuKind {
  HEADER
  FOOTER
  TOPBAR
}

model NavLink {
  id       String    @id @default(cuid())
  menu     MenuKind  @default(HEADER)
  labelAr  String
  labelEn  String
  href     String
  icon     String? // معرّف أيقونة مثل i-college
  group    String? // لعمود الفوتر أو التجميع
  parentId String?
  parent   NavLink?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavLink[] @relation("NavChildren")
  order    Int       @default(0)
  visible  Boolean   @default(true)

  @@index([menu, parentId, order])
  @@map("nav_links")
}

// ---------------------- الهيئة العلمية ----------------------
model Scholar {
  accounts User[]

  courses  Course[]
  sessions LiveSession[]

  id            String  @id @default(cuid())
  nameAr        String
  nameEn        String
  rankAr        String?
  rankEn        String?
  specAr        String?
  specEn        String?
  bioAr         String?
  bioEn         String?
  photoUrl      String?
  countryAr     String?
  countryEn     String?
  isCouncilHead Boolean @default(false)
  isCouncil     Boolean @default(false) // عضو المجلس العلمي
  order         Int     @default(0)
  visible       Boolean @default(true)

  @@map("scholars")
}

// ---------------------- البرامج والمراحل والمقرّرات ----------------------
model ProgramStage {
  stageEnrollments StageEnrollment[]
  sessions         LiveSession[]
  certificates     Certificate[]

  id       String   @id @default(cuid())
  key      String   @unique // foundation | advanced | research
  numAr    String? // "المرحلة الأولى"
  numEn    String?
  titleAr  String
  titleEn  String
  metaAr   String?
  metaEn   String?
  descAr   String?
  descEn   String?
  items    Json? // ["مقدّمة ابن الصلاح", ...] ثنائي؟ نخزّن {ar:[],en:[]}
  icon     String?
  moreHref String?
  order    Int      @default(0)
  visible  Boolean  @default(true)
  courses  Course[]

  @@map("program_stages")
}

model Course {
  // --- تفاصيل المقرّر ونظام التعلّم ---
  summaryAr            String?
  summaryEn            String?
  hours                Int?
  startsOn             DateTime?
  published            Boolean       @default(false)
  publishAt            DateTime?
  enrollmentOpensAt    DateTime?
  enrollmentClosesAt   DateTime?
  prerequisiteCourseId String?
  completionPercent    Int           @default(100)
  minimumQuizScore     Int?
  autoCertificate      Boolean       @default(false)
  allowSelfEnrollment  Boolean       @default(true)
  instructorId         String?
  instructor           Scholar?      @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  modules              Module[]
  enrollments          Enrollment[]
  sessions             LiveSession[]
  assignments          Assignment[]
  quizzes              Quiz[]
  certificates         Certificate[]

  id       String        @id @default(cuid())
  slug     String?       @unique // رابط SEO: «دورة-مصطلح-الحديث-التطبيقي» — يُولَّد من العنوان
  titleAr  String
  titleEn  String
  descAr   String?
  descEn   String?
  category String? // مفتاح فلترة
  metaAr   String? // "٦ لقاءات"
  metaEn   String?
  imageUrl String?
  href     String?
  stageId  String?
  stage    ProgramStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  order    Int           @default(0)
  visible  Boolean       @default(true)

  @@map("courses")
}

// ---------------------- الأخبار والفعاليات ----------------------
model NewsItem {
  id        String   @id @default(cuid())
  slug      String?  @unique
  titleAr   String
  titleEn   String
  excerptAr String?
  excerptEn String?
  bodyAr    String?
  bodyEn    String?
  imageUrl  String?
  tagAr     String?
  tagEn     String?
  date      DateTime @default(now())
  featured  Boolean  @default(false)
  visible   Boolean  @default(true)
  order     Int      @default(0)

  @@map("news_items")
}

model Event {
  id       String   @id @default(cuid())
  titleAr  String
  titleEn  String
  descAr   String?
  descEn   String?
  whenAr   String?
  whenEn   String?
  tagAr    String?
  tagEn    String?
  imageUrl String?
  href     String?
  date     DateTime
  order    Int      @default(0)
  visible  Boolean  @default(true)

  @@map("events")
}

// ---------------------- ديوان العلماء ----------------------
model DiwanCategory {
  id      String        @id @default(cuid())
  key     String        @unique
  labelAr String
  labelEn String
  order   Int           @default(0)
  threads DiwanThread[]

  @@map("diwan_categories")
}

model DiwanThread {
  id         String         @id @default(cuid())
  titleAr    String
  titleEn    String
  authorAr   String
  authorEn   String
  rankAr     String?
  rankEn     String?
  categoryId String?
  category   DiwanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  count      Int            @default(0)
  pinned     Boolean        @default(false)
  timeAr     String?
  timeEn     String?
  order      Int            @default(0)
  visible    Boolean        @default(true)

  @@map("diwan_threads")
}

// ---------------------- الإصدارات والمجلة ----------------------
model JournalIssue {
  id       String  @id @default(cuid())
  nameAr   String
  nameEn   String
  subAr    String?
  subEn    String?
  noAr     String?
  noEn     String?
  dateAr   String?
  dateEn   String?
  tagAr    String?
  tagEn    String?
  coverUrl String?
  href     String?
  isNew    Boolean @default(false)
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@map("journal_issues")
}

model Paper {
  id       String  @id @default(cuid())
  no       String?
  titleAr  String
  titleEn  String
  metaAr   String?
  metaEn   String?
  tagAr    String?
  tagEn    String?
  imageUrl String?
  fileUrl  String?
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@map("papers")
}

// ---------------------- المكتبة والمصادر ----------------------
model LibraryResource {
  id       String  @id @default(cuid())
  nameAr   String
  nameEn   String
  url      String?
  category String?
  descAr   String?
  descEn   String?
  icon     String?
  tags     Json? // {ar:[],en:[]}
  featured Boolean @default(false)
  active   Boolean @default(true)
  order    Int     @default(0)

  @@map("library_resources")
}

// ---------------------- الصفحات والأقسام ----------------------
enum PageStatus {
  PUBLISHED
  DRAFT
}

model Page {
  id           String     @id @default(cuid())
  slug         String     @unique // index, about, faculty, ...
  template     String     @default("inner") // home | inner | portal
  titleAr      String
  titleEn      String
  metaDescAr   String?
  metaDescEn   String?
  heroKickerAr String?
  heroKickerEn String?
  heroTitleAr  String?
  heroTitleEn  String?
  heroIntroAr  String?
  heroIntroEn  String?
  heroImage    String?
  bodyHtmlAr   String? // محتوى <main> القابل للتحرير
  bodyHtmlEn   String?
  seoTitleAr   String?
  seoTitleEn   String?
  seoDescAr    String?
  seoDescEn    String?
  ogImage      String?
  status       PageStatus @default(PUBLISHED)
  order        Int        @default(0)
  updatedAt    DateTime   @updatedAt

  @@map("pages")
}

// ---------------------- قوائم محتوى الصفحات الداخلية ----------------------
// جداول عامّة يميّزها حقل `section` (مفتاح القسم في الموقع)، تُغني عن
// تكرار موديل لكل شبكة بطاقات أو جدول أو قائمة أسئلة.

/// بطاقات الشبكات: programs | ijazat | paid-books | research
model ContentCard {
  id       String  @id @default(cuid())
  section  String
  titleAr  String
  titleEn  String
  descAr   String?
  descEn   String?
  tagAr    String?
  tagEn    String?
  metaAr   String? // سطر أسفل البطاقة
  metaEn   String?
  imageUrl String?
  href     String?
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@index([section, order])
  @@map("content_cards")
}

/// الأسئلة الشائعة: admissions | publication-rules
model Faq {
  id         String  @id @default(cuid())
  section    String
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  order      Int     @default(0)
  visible    Boolean @default(true)

  @@index([section, order])
  @@map("faqs")
}

/// خطوات المسارات (خط زمني): admissions | publications
model ProcessStep {
  id      String  @id @default(cuid())
  section String
  titleAr String
  titleEn String
  descAr  String?
  descEn  String?
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([section, order])
  @@map("process_steps")
}

/// جدول بيانات من عمودين (تسمية/قيمة): accreditation
model InfoRow {
  id      String  @id @default(cuid())
  section String
  labelAr String
  labelEn String
  valueAr String?
  valueEn String?
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([section, order])
  @@map("info_rows")
}

/// جدول الخطة الدراسية في صفحة المناهج
model CurriculumRow {
  id         String  @id @default(cuid())
  stageAr    String
  stageEn    String
  axesAr     String?
  axesEn     String?
  practiceAr String?
  practiceEn String?
  outcomeAr  String?
  outcomeEn  String?
  order      Int     @default(0)
  visible    Boolean @default(true)

  @@map("curriculum_rows")
}

// ---------------------- نماذج الموقع العام (إدخال الزوّار) ----------------------
enum SubmissionStatus {
  NEW // جديد
  IN_PROGRESS // قيد المعالجة
  DONE // منجز
  ARCHIVED // مؤرشف
}

model ContactMessage {
  id         String           @id @default(cuid())
  name       String
  email      String
  department String?
  message    String
  lang       String           @default("ar")
  status     SubmissionStatus @default(NEW)
  note       String?
  createdAt  DateTime         @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

model AdmissionApplication {
  id         String           @id @default(cuid())
  name       String
  email      String
  phone      String?
  country    String?
  program    String?
  background String?
  feeOption  String? // full | reduced | free
  lang       String           @default("ar")
  status     SubmissionStatus @default(NEW)
  note       String?
  createdAt  DateTime         @default(now())

  // --- المقابلة العلمية (الخطوة الثالثة من القبول) — تُحجز عبر Calendly ---
  // تُملأ تلقائيًّا من ويب هوك Calendly عند حجز الطالب موعده.
  interviewAt      DateTime?
  /// رابط لقاء المقابلة (Zoom/Meet) كما يرسله Calendly.
  interviewUrl     String?
  /// حالة الموعد: scheduled | canceled
  interviewStatus  String?
  /// معرّف الحدث لدى Calendly — يمنع تكرار المعالجة عند إعادة الإرسال.
  /// فهرس عادي لا قيد تفرّد: عدم التكرار يُفرض في كود الويب هوك (بحث قبل الكتابة).
  calendlyEventUri String?

  @@index([calendlyEventUri])
  @@index([status, createdAt])
  @@map("admission_applications")
}

model ResearchSubmission {
  id          String           @id @default(cuid())
  authorName  String
  authorEmail String
  title       String
  paperType   String?
  field       String?
  abstract    String?
  docPath     String? // مسار Blob خاصّ — يُنزَّل من اللوحة برابط موقَّع
  docName     String?
  pdfPath     String?
  pdfName     String?
  lang        String           @default("ar")
  status      SubmissionStatus @default(NEW)
  note        String?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@map("research_submissions")
}

// ---------------------- الوسائط ----------------------
model Media {
  id               String   @id @default(cuid())
  url              String
  pathname         String?
  filename         String
  altAr            String?
  altEn            String?
  width            Int?
  height           Int?
  size             Int?
  mime             String?
  assetType        String   @default("image")
  private          Boolean  @default(false)
  thumbnailUrl     String?
  captionUrl       String?
  durationSec      Int?
  processingStatus String   @default("ready")
  createdAt        DateTime @default(now())

  @@map("media")
}

// ---------------------- شرائح الهيرو (الصفحة الرئيسية) ----------------------
model HeroSlide {
  id      String  @id @default(cuid())
  imageAr String // مسار الصورة العربية
  imageEn String // مسار الصورة الإنجليزية
  altAr   String?
  altEn   String?
  order   Int     @default(0)
  visible Boolean @default(true)

  @@map("hero_slides")
}

// ---------------------- منصّات التواصل (روابط) ----------------------
model SocialLink {
  id      String  @id @default(cuid())
  key     String  @unique // youtube, facebook, x, snapchat, tiktok, instagram, telegram, whatsapp
  labelAr String
  labelEn String
  url     String  @default("#")
  icon    String // s-yt, s-fb, ...
  order   Int     @default(0)
  visible Boolean @default(true)

  @@map("social_links")
}

// ==========================================================================
// نظام التعلّم (LMS) — المقرّرات والمجالس والتقييم والشهادات
// ==========================================================================

// =====================================================
// (٢) بنية المحتوى التعليمي — مقرّر ← وحدة ← درس ← مرفق
// ==========================================================================

enum LessonKind {
  VIDEO // درس مرئي (رابط خارجي أو مستضاف)
  PDF // ملفّ للقراءة
  TEXT // متن مكتوب داخل المنصّة
  LIVE // موعد مجلس مباشر مرتبط بـLiveSession
  QUIZ // اختبار مرتبط بـQuiz
}

/// وحدة دراسيّة داخل المقرّر (يقابلها «المحور» في الخطّة الدراسيّة).
model Module {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr  String
  titleEn  String
  descAr   String?
  descEn   String?
  order    Int     @default(0)
  visible  Boolean @default(true)

  lessons Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

/// درس مفرد داخل وحدة.
model Lesson {
  id                   String     @id @default(cuid())
  moduleId             String
  module               Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titleAr              String
  titleEn              String
  kind                 LessonKind @default(VIDEO)
  // VIDEO: رابط يوتيوب/فيميو غير مُدرَج، أو رابط استضافة لاحقًا
  videoUrl             String?
  // TEXT: متن الدرس (HTML)
  bodyAr               String?
  bodyEn               String?
  // LIVE/QUIZ: ارتباط اختياري بالكيان المقابل
  sessionId            String?
  quizId               String?
  durationMin          Int?
  unlockAt             DateTime?
  dripDays             Int        @default(0)
  prerequisiteLessonId String?
  transcriptAr         String?
  transcriptEn         String?
  downloadable         Boolean    @default(false)
  thumbnailUrl         String?
  // معاينة مجّانيّة تُفتح لغير المسجَّلين (تسويق المقرّر)
  freePreview          Boolean    @default(false)
  order                Int        @default(0)
  visible              Boolean    @default(true)

  attachments LessonAttachment[]
  progress    LessonProgress[]

  @@index([moduleId, order])
  @@map("lessons")
}

/// ملفّات مرفقة بالدرس (نصّ محقَّق، جدول تخريج، ورقة تطبيق…).
model LessonAttachment {
  id       String  @id @default(cuid())
  lessonId String
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  titleAr  String
  titleEn  String
  url      String
  filename String?
  sizeKb   Int?
  order    Int     @default(0)

  @@index([lessonId, order])
  @@map("lesson_attachments")
}

// ==========================================================================
// (٣) التسجيل والتقدّم
// ==========================================================================

enum EnrollmentStatus {
  PENDING // بانتظار الاعتماد أو سداد الرسوم
  ACTIVE // مُفعَّل
  COMPLETED // مُنجَز
  CANCELLED // ملغى أو منسحب
}

/// قيد الطالب في مرحلة أكاديميّة (التأسيس/التخصّص/البحث).
model StageEnrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId     String
  stage       ProgramStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(PENDING)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@unique([userId, stageId])
  @@map("stage_enrollments")
}

/// تسجيل الطالب في مقرّر/دورة بعينها.
model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(PENDING)
  // نظام الرسوم المرن المعلَن في الموقع: full | reduced | free
  feeOption   String?          @default("free")
  progressPct Int              @default(0) // 0..100 — يُحدَّث من LessonProgress
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  payments Payment[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

/// تقدّم الطالب في درس مفرد.
model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  seconds   Int      @default(0) // آخر موضع مشاهدة
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ==========================================================================
// (٤) المجالس المباشرة والتقويم
// ==========================================================================
// قرار المشروع: **Zoom بحساب مدفوع**. الحساب الموثَّق يُضاف في آخر المشروع،
// والتكامل مبنيّ ليعمل قبله وبعده بلا تغيير كود (`src/lib/zoom.ts`):
//   • بلا مفاتيح بيئة → وضع يدوي: المحرّر يلصق رابط الانضمام في joinUrl.
//   • بالمفاتيح → يُنشأ المجلس على Zoom تلقائيًّا، ويعود joinUrl/startUrl،
//     ويُملأ recordingUrl من التسجيل السحابي عبر الويب هوك، ويُملأ جدول
//     Attendance من تقرير المشاركين. (كلاهما ميزة باقة مدفوعة.)
// وهذا يُبطل الحاجة للرفع اليدوي، ويُوفي وعد الموقع بأن «المجالس المباشرة
// مسجَّلة وتُتاح لاحقًا» تلقائيًّا.

/// مجلس مباشر: محاضرة أو مجلس سماع مسنَد أو مجلس مذاكرة.
model LiveSession {
  id      String  @id @default(cuid())
  titleAr String
  titleEn String
  descAr  String?
  descEn  String?

  // الارتباط: بمقرّر، أو بمرحلة، أو عامّ للكلّية كلّها (كلاهما فارغ)
  courseId String?
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stageId  String?
  stage    ProgramStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  instructorId String?
  instructor   Scholar? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  startsAt    DateTime
  endsAt      DateTime?
  durationMin Int       @default(90)

  // zoom | meet | youtube | other
  provider String  @default("zoom")
  /// رابط انضمام الطلاب — يُنشئه Zoom، أو يُلصق يدويًّا في الوضع غير المُفعَّل.
  joinUrl  String?
  /// رمز دخول المجلس إن وُجد.
  passcode String?

  // --- حقول Zoom (تبقى فارغة في الوضع اليدوي) ---
  zoomMeetingId String? @unique
  /// رابط المضيف — **سرّي**: لا يُعرض إلا للمحاضر والمدير، ولا يُرسل للطلاب أبدًا.
  zoomStartUrl  String?

  /// يُملأ تلقائيًّا من ويب هوك recording.completed، أو يدويًّا عند غياب المفاتيح.
  recordingUrl       String?
  /// Zoom يحمي التسجيلات بكلمة مرور — بدونها يتعذّر تشغيل الرابط.
  recordingPasscode  String?
  recordingReadyAt   DateTime?
  /// آخر مزامنة لتقرير حضور Zoom إلى جدول Attendance.
  attendanceSyncedAt DateTime?

  // --- تنبيهات الطلاب بالبريد ---
  // تُختم عند إرسال كل تذكير، فلا يُرسل مرّتين مهما تكرّر تشغيل المهمّة.
  reminder24SentAt DateTime?
  reminder1SentAt  DateTime?

  // مجلس مفتوح للعامّة (يظهر في تقويم الموقع بلا تسجيل دخول)
  isPublic Boolean @default(false)
  visible  Boolean @default(true)

  attendance Attendance[]

  @@index([startsAt])
  @@index([courseId, startsAt])
  @@map("live_sessions")
}

/// حضور الطالب مجلسًا مباشرًا.
model Attendance {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  /// دقائق الحضور الفعليّة — من تقرير مشاركي Zoom.
  minutes   Int         @default(0)
  present   Boolean     @default(true)
  /// zoom | manual — مصدر السجلّ، لئلّا تدهس المزامنة تعديلًا يدويًّا.
  source    String      @default("manual")
  note      String?

  @@unique([userId, sessionId])
  @@map("attendance")
}

// ==========================================================================
// (٥) الواجبات والاختبارات
// ==========================================================================

enum AssignmentState {
  DRAFT // مسوّدة عند الطالب
  SUBMITTED // مُسلَّم
  RETURNED // أُعيد للتعديل
  GRADED // مُصحَّح
}

model Assignment {
  id            String    @id @default(cuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr       String
  titleEn       String
  descAr        String?
  descEn        String?
  dueAt         DateTime?
  maxScore      Int       @default(100)
  rubric        Json?
  allowLate     Boolean   @default(true)
  gradingPeriod String?
  order         Int       @default(0)
  visible       Boolean   @default(true)

  submissions AssignmentSubmission[]

  @@index([courseId, order])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("StudentWork", fields: [userId], references: [id], onDelete: Cascade)
  text         String?
  fileUrl      String?
  fileName     String?
  state        AssignmentState @default(DRAFT)
  submittedAt  DateTime?
  score        Int?
  feedback     String?
  gradedById   String?
  gradedBy     User?           @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime?

  @@unique([assignmentId, userId])
  @@index([state])
  @@map("assignment_submissions")
}

enum QuestionKind {
  SINGLE // اختيار واحد
  MULTI // اختيار متعدّد
  TRUEFALSE // صواب/خطأ
  SHORT // إجابة قصيرة (تصحيح يدوي)
}

/// اختبار أو مراجعة تفاعليّة.
model Quiz {
  id                  String    @id @default(cuid())
  courseId            String?
  course              Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr             String
  titleEn             String
  descAr              String?
  descEn              String?
  timeLimitMin        Int? // بلا قيمة = بلا توقيت
  passScore           Int       @default(60) // نسبة النجاح %
  attemptsAllowed     Int       @default(0) // 0 = بلا حدّ
  retakeCooldownHours Int       @default(0)
  questionPoolSize    Int       @default(0)
  availableAt         DateTime?
  closesAt            DateTime?
  shuffle             Boolean   @default(true)
  visible             Boolean   @default(true)

  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id        String       @id @default(cuid())
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  kind      QuestionKind @default(SINGLE)
  textAr    String
  textEn    String
  explainAr String? // شرح الإجابة بعد التسليم
  explainEn String?
  points    Int          @default(1)
  order     Int          @default(0)

  choices Choice[]

  @@index([quizId, order])
  @@map("questions")
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAr     String
  textEn     String
  correct    Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId, order])
  @@map("choices")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  // { questionId: [choiceId…] | "نصّ" }
  answers     Json?
  questionIds Json?
  score       Int?
  passed      Boolean?

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

// ==========================================================================
// (٦) الشهادات والإجازات
// ==========================================================================
// الموقع يَعِد بـ«إجازاتُك المسنَدة برقم توثيقٍ ورمز تحقُّقٍ قابلٍ للمشاركة»،
// وصفحة certificates.html العامّة هي واجهة التحقّق.

enum CertificateKind {
  CERTIFICATE // شهادة إتمام مقرّر/مرحلة
  IJAZA // إجازة مسنَدة
}

model Certificate {
  id     String          @id @default(cuid())
  kind   CertificateKind @default(CERTIFICATE)
  userId String
  user   User            @relation("CertificateHolder", fields: [userId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  stageId  String?
  stage    ProgramStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  titleAr     String
  titleEn     String
  serial      String  @unique // رقم التوثيق المطبوع على الوثيقة
  verifyCode  String  @unique // رمز التحقّق العلني القصير
  // للإجازات: نصّ السند والمُجيز
  isnadAr     String?
  isnadEn     String?
  grantedByAr String?
  grantedByEn String?

  issuedAt   DateTime @default(now())
  issuedById String?
  issuedBy   User?    @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  pdfUrl     String?
  revoked    Boolean  @default(false)
  revokeNote String?

  @@index([userId, issuedAt])
  @@map("certificates")
}

// ==========================================================================
// (٧) الرسوم والمدفوعات
// ==========================================================================
// بوابة الدفع وحسابها على العميل (البند التاسع من العقد). النموذج محايد
// تجاه المزوّد: providerRef يحفظ معرّف العمليّة أيًّا كانت البوابة.

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED // إعفاء (المسار المجّاني أو المخفَّض)
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("QAR")
  status       PaymentStatus @default(PENDING)
  provider     String? // اسم البوابة
  providerRef  String? // معرّف العمليّة لدى البوابة
  method       String? // card | transfer | cash
  paidAt       DateTime?
  note         String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

// ==========================================================================
// (٨) الإشعارات
// ==========================================================================
// إشعارات داخل المنصّة الآن، وهي نفسها مصدر إشعارات Push في التطبيق لاحقًا.

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // session | assignment | grade | certificate | payment | announcement
  kind      String    @default("announcement")
  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ==========================================================================
// (٩) منتدى الطلاب — ⚠️ خارج بنود العقد
// ==========================================================================
// العقد لا يذكر منتدًى، لكنّ الموقع يَعِد به في موضعين ظاهرين: بطاقة
// «منتدى الطلاب» المميَّزة في منطقة الطالب، والخطوة الرابعة من القبول.
// أُدرِج هنا للاكتمال — يُحذف إن قُرِّر إخراجه من النطاق، أو يُسعَّر ملحقًا
// وفق البند العاشر.

model ForumTopic {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  courseId  String?
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  lang      String   @default("ar")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies ForumReply[]

  @@index([createdAt])
  @@map("forum_topics")
}

model ForumReply {
  id        String     @id @default(cuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
  @@map("forum_replies")
}

// ============================================================================
// إدارة التعلّم المتقدمة
// ============================================================================

model AcademicTerm {
  id              String    @id @default(cuid())
  key             String    @unique
  titleAr         String
  titleEn         String
  startsAt        DateTime
  endsAt          DateTime
  gradingStartsAt DateTime?
  gradingEndsAt   DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([active, startsAt])
  @@map("academic_terms")
}

model Cohort {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String
  courseId  String?
  stageId   String?
  termId    String?
  startsAt  DateTime?
  endsAt    DateTime?
  capacity  Int?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([courseId, termId])
  @@map("cohorts")
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  userId   String
  joinedAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([userId])
  @@map("cohort_members")
}

model AcademicCalendarEntry {
  id        String    @id @default(cuid())
  termId    String?
  courseId  String?
  titleAr   String
  titleEn   String
  descAr    String?
  descEn    String?
  startsAt  DateTime
  endsAt    DateTime?
  kind      String    @default("event")
  visible   Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([startsAt, visible])
  @@map("academic_calendar_entries")
}

model QuestionBankItem {
  id         String       @id @default(cuid())
  kind       QuestionKind @default(SINGLE)
  textAr     String
  textEn     String?
  explainAr  String?
  explainEn  String?
  choices    Json?
  tags       Json?
  difficulty Int          @default(1)
  points     Int          @default(1)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([active, difficulty])
  @@map("question_bank_items")
}

model Announcement {
  id          String    @id @default(cuid())
  courseId    String?
  cohortId    String?
  titleAr     String
  titleEn     String
  bodyAr      String
  bodyEn      String?
  publishAt   DateTime  @default(now())
  expiresAt   DateTime?
  pinned      Boolean   @default(false)
  visible     Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([courseId, publishAt])
  @@index([visible, publishAt])
  @@map("announcements")
}

model CourseMessage {
  id          String    @id @default(cuid())
  courseId    String
  senderId    String
  recipientId String?
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([courseId, createdAt])
  @@index([recipientId, readAt])
  @@map("course_messages")
}

model StudentNote {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  body        String
  positionSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, lessonId])
  @@map("student_notes")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  positionSec Int?
  createdAt   DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("bookmarks")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SystemJob {
  id         String    @id @default(cuid())
  kind       String
  status     String    @default("queued")
  payload    Json?
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([status, runAfter])
  @@map("system_jobs")
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

// ==========================================================================
// تطبيق الجوال — المصادقة والإشعارات
// ==========================================================================
// التطبيق لا يستطيع استعمال كعكة الجلسة (NextAuth) لأنّها مربوطة بالمتصفّح،
// فله مسار مستقلّ: رمز وصول قصير العمر (JWT) + رمز تجديد طويل العمر يُخزَّن
// **مجزَّأً** هنا. تخزين الرمز خامًّا يعني أنّ تسريب القاعدة يمنح دخولًا دائمًا.

model RefreshToken {
  id         String    @id @default(cuid())
  /// تجزئة SHA-256 للرمز — الرمز نفسه لا يُحفظ قطّ.
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// معرّف الجهاز: يتيح للمستخدم إنهاء جلسة جهازٍ بعينه.
  deviceId   String?
  deviceName String?
  expiresAt  DateTime
  /// يُختم عند التدوير أو الخروج — لا يُحذف السجلّ ليبقى أثرٌ للتدقيق.
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// رمز إشعارات Expo لكل جهاز. الرمز يتبدّل من تلقائه أحيانًا، فيُحدَّث بالـupsert.
model DeviceToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // ios | android
  deviceId   String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}
